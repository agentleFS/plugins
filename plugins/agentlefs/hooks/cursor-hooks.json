{
  "version": 1,
  "description": "Remember session events and recall relevant agentleFS context; brief agents on their agentleFS projects. Cursor-native event names and command shape; see README for host limits.",
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/memory_hooks.py\" hook",
        "timeout": 15
      },
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/project_hooks.py\" session-start",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/memory_hooks.py\" hook",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/memory_hooks.py\" hook",
        "timeout": 10
      },
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/project_hooks.py\" nudge",
        "matcher": "message_write|identity_write",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/memory_hooks.py\" hook",
        "timeout": 10
      },
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/project_hooks.py\" stop",
        "timeout": 5,
        "loop_limit": 1
      }
    ],
    "preCompact": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/memory_hooks.py\" hook",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/memory_hooks.py\" hook",
        "timeout": 3
      }
    ],
    "subagentStop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/project_hooks.py\" stop",
        "timeout": 5,
        "loop_limit": 1
      }
    ]
  }
}
