{
  "description": "Brief agents on their agentleFS projects and suggest the skills that can help.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/project_hooks.py\" session-start",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%/scripts/project_hooks.py\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/project_hooks.py\" assemble",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%/scripts/project_hooks.py\" assemble",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "agentlefs",
            "tool": "brief_me",
            "input": {
              "only": "projects"
            },
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*(message_write|identity_write|coordination_write|doc_create|doc_update|read|browse|Read|read_file)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/project_hooks.py\" nudge",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%/scripts/project_hooks.py\" nudge",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/project_hooks.py\" stop",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%/scripts/project_hooks.py\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/project_hooks.py\" stop",
            "commandWindows": "py -3 \"%CLAUDE_PLUGIN_ROOT%/scripts/project_hooks.py\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
