#!/bin/sh
# afs-run: run a worker as an agentleFS agent, keeping its short-lived credentials fresh.
#
#   afs-run login [--folder <path>] [--name <machine name>]   sign this machine in, once
#   afs-run status                                            say whether this machine is signed in
#   afs-run logout                                            revoke this machine and forget it
#   afs-run --agent @handle [--github owner/repo [--scope "issues:write"]] -- <command...>
#   afs-run mcp --agent @handle                               a stdio MCP server for a client that
#                                                             sends only a static header
#
# ON A MACHINE WITH NO BROWSER (a server, CI, a box where Temporal starts `claude -p`): run
# `afs-run login` once. It prints an address and a code; open the address in any browser where you
# are signed in to agentleFS, type the code, check what is asking, and approve (OAuth 2.0 Device
# Authorization Grant, RFC 8628). The machine then holds its own credential, for the one folder you
# approved, in a file only you can read (AGENTLEFS_MACHINE_CREDENTIAL, default
# ${XDG_CONFIG_HOME:-~/.config}/agentlefs/machine-credential). Nothing secret is printed or pasted.
# An AI agent that runs `afs-run login` for a person never approves it itself: it relays the address
# and the code to that person, word for word, and waits while they approve in their own browser.
# From then on, `afs-run --agent @x -- claude -p ...` starts agents that work in that folder (an
# agent added there in the console as Editor or Manager, or spawned there with folder=).
# Revoke the machine in the console (Machines, on its /device page) or with `afs-run logout`. It lasts
# 90 days, ends if unused for 30, and ends if its credential is used from two places.
#
# IN A GITHUB ACTIONS JOB: trust the workflow on the folder in the console (Access, Trust a GitHub
# Actions workflow), give the job `permissions: id-token: write`, and set AGENTLEFS_TRUST to the
# trust's id (not a secret). With no AGENTLEFS_TOKEN_FILE or AGENTLEFS_TOKEN, afs-run asks GitHub for
# the job's ID token, with the token endpoint as its audience, and exchanges it (RFC 8693, jwt
# subject). Each exchange spends one ID token, so --github asks GitHub for another. No secret is
# stored in the repository or on the runner.
#
# A TOKEN, NEVER A SEAT. afs-run gets the agent's token and never takes, renews or releases the
# agent's seat: a token says who the agent is, never whose turn it is. The worker in the command takes
# its own seat (seat_write take_seat, over `afs-run mcp` or any MCP connection) and passes it as
# `seat` on its calls; agentleFS refuses a seated agent's writes without it, whatever the token.
#
# A supervisor in the shape of a Kubernetes projected token or Vault Agent: it exchanges the
# credential it starts from (see below; used once and then forgotten) at the agentleFS token
# endpoint (OAuth 2.0 Token Exchange, RFC 8693), starts the command, and while it runs renews each
# credential at about two thirds of its lifetime, writing the current one to a file:
#   AGENTLEFS_TOKEN_FILE  the agent's token (15 minutes, renewed); the MCP server over stdio and the
#                         agentlefs CLI read it on every call. AGENTLEFS_TOKEN holds the FIRST one only.
#   AGENTLEFS_URL         the MCP endpoint, so the agentlefs CLI in the command reaches the same server.
#   GH_TOKEN_FILE         with --github, a GitHub App installation token for that one repository;
#                         git reads it on every use (a credential helper set through GIT_CONFIG_*).
#                         GH_TOKEN / GITHUB_TOKEN hold the FIRST one only: an environment variable
#                         cannot rotate, so a long run should read the file. Each replaced GitHub
#                         token is revoked at GitHub.
#   AGENTLEFS_SEAT        read, never set: with --github for an agent driven from a seat, the seat of
#                         the shift that started this, which GitHub's credential needs (agentleFS cannot
#                         fence a write inside GitHub). The shift keeps it; when it changes hands or
#                         lapses, the GitHub renewal is refused and the command stopped.
# AN MCP CLIENT THAT ONLY SENDS A STATIC HEADER (Cline, a generic HTTP client): configure it with the
# command `afs-run mcp --agent @x` instead of a URL and a token. It is a stdio MCP server that forwards
# each JSON-RPC message on its standard input to agentleFS over HTTP, carrying the agent's CURRENT
# token from the renewal below, and writes each answer to standard output as one line. The client
# takes the agent's seat itself and passes it as `seat`; its take_seat is sent naming the client and
# this machine ("<client> via afs-run on <machine>"), so a person sees who holds the seat. Nothing
# secret goes in the client's configuration, and it keeps working past any one token's 15 minutes.
# Messages are forwarded one at a time, in order.
# Every renewal is checked again by agentleFS. When one is refused for good (the folder's grant
# revoked, the agent asleep, the driver no longer allowed, GitHub's seat lost), the command is stopped
# (TERM, then KILL after 10 s) with a message on stderr and exit status 77. When the command ends or
# this is signalled, the GitHub token and the renewal tokens are revoked and the files removed.
# No token is printed or put on a command line: curl gets them on its standard input.
#
# The same in every harness and outside one: POSIX sh and curl, nothing else. The credential it starts
# from is read as the agentlefs CLI and the stdio MCP server read theirs: AGENTLEFS_TOKEN_FILE when set
# (so a command under another afs-run starts from its current token, for that same agent only: a
# capped agent token exchanges for no other), else AGENTLEFS_TOKEN, else this
# machine's own from `afs-run login`. On a machine that is signed in, a token variable it did not put
# there itself is refused by name rather than chosen silently over the machine's sign-in. AGENTLEFS_URL (the MCP endpoint, the CLI's name; default the
# server this machine signed in to, else https://mcp.agentlefs.com/mcp) names the server;
# AGENTLEFS_TOKEN_ENDPOINT (default: that origin's /token) and AGENTLEFS_GITHUB_API (default
# https://api.github.com) override. Published at <server>/install/afs-run, with its SHA-256 beside it.
set -u
umask 077

die() { printf 'afs-run: %s\n' "$*" >&2; exit 2; }
command -v curl >/dev/null 2>&1 || die "curl is required"

# A curl config line's value in double quotes, with \ and " escaped.
q() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
str() { printf '%s' "$answer" | sed -n "s/.*\"$1\" *: *\"\\([^\"]*\\)\".*/\\1/p"; }
num() { printf '%s' "$answer" | sed -n "s/.*\"$1\" *: *\\([0-9][0-9]*\\).*/\\1/p"; }
now() { date +%s; }

# post: curl with the config in $cfg on its stdin; sets `answer` (the body) and `code` (the HTTP
# status, 000 when nothing answered). Not the end of a pipeline: that would run in a subshell.
post() {
  out=$({ printf '%s\n' "$cfg"; printf 'user-agent = "afs-run"\n'; } | curl -sS --max-time 30 -w '\n%{http_code}' -K - 2>/dev/null) || out="
000"
  code=$(printf '%s' "$out" | tail -n 1)
  answer=$(printf '%s' "$out" | sed '$d')
}

# This machine's own credential (`afs-run login`): the token endpoint it came from and a rotating
# refresh token, in a 0600 file in a 0700 directory.
cred_file="${AGENTLEFS_MACHINE_CREDENTIAL:-}"
if [ -z "$cred_file" ]; then
  conf="${XDG_CONFIG_HOME:-}"
  [ -n "$conf" ] || { [ -n "${HOME:-}" ] && conf="$HOME/.config"; }
  [ -n "$conf" ] && cred_file="$conf/agentlefs/machine-credential"
fi
cred_get() { [ -n "$cred_file" ] && [ -r "$cred_file" ] && sed -n "s/^$1=//p" "$cred_file" | head -n 1; }
# What names this afs-run to a person: "afs-run on <machine>", the name the machine signed in under
# (shown at login and on its /device page), else plain "afs-run". A seat a worker takes through the
# bridge is shown as held by "<client> via" it, where curl's own name said nothing. Never the host
# name unasked: everyone who sees the seat would see it.
machine_label() {
  m=$(cred_get name | tr -cd 'A-Za-z0-9 ._-' | cut -c 1-60)
  if [ -n "$m" ]; then printf 'afs-run on %s' "$m"; else printf 'afs-run'; fi
}

# The token endpoint and the MCP endpoint: AGENTLEFS_TOKEN_ENDPOINT, else AGENTLEFS_URL's origin
# (AGENTLEFS_MCP_URL is this script's earlier name for it), else the server this machine signed in
# to, else agentleFS's own.
resolve_endpoints() {
  mcp_url="${AGENTLEFS_URL:-${AGENTLEFS_MCP_URL:-}}"
  if [ -n "${AGENTLEFS_TOKEN_ENDPOINT:-}" ]; then
    endpoint="$AGENTLEFS_TOKEN_ENDPOINT"
  elif [ -n "$mcp_url" ]; then
    origin=$(printf '%s' "$mcp_url" | sed -n 's|^\(https\{0,1\}://[^/?#]*\).*|\1|p')
    [ -n "$origin" ] || die "AGENTLEFS_URL is not an http(s) URL"
    endpoint="$origin/token"
  elif [ -n "$(cred_get endpoint)" ]; then
    endpoint=$(cred_get endpoint)
  else
    endpoint="https://mcp.agentlefs.com/token"
  fi
  [ -n "$mcp_url" ] || mcp_url="${endpoint%/token}/mcp"
  revoke_url="${endpoint%/token}/revoke"
}

# Write the credential file whole, through a temporary file beside it; nothing is printed. The
# machine's name ($2, else the one already saved) names the seats workers take through it (machine_label).
save_credential() {
  cdir=$(dirname "$cred_file")
  mkdir -p "$cdir" && chmod 700 "$cdir" || return 1
  saved_name="${2:-$(cred_get name)}"
  printf 'endpoint=%s\nrefresh_token=%s\nsaved=%s\nname=%s\n' "$endpoint" "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$saved_name" > "$cred_file.tmp.$$" &&
    chmod 600 "$cred_file.tmp.$$" && mv -f "$cred_file.tmp.$$" "$cred_file" || { rm -f "$cred_file.tmp.$$"; return 1; }
}

# The machine's refresh token rotates, and a spent one presented again ends the machine. So it is
# spent and its successor stored one afs-run at a time, under a lock directory beside the file,
# holding the owner's pid. A lock whose owner is gone (stopped mid-refresh, even by SIGKILL) is taken
# over rather than waited out. Sets `person` to the machine's 15-minute access token.
machine_sign_in() {
  lock="$cred_file.lock"
  i=0
  until mkdir "$lock" 2>/dev/null; do
    owner=$(cat "$lock/pid" 2>/dev/null)
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then rm -rf "$lock"; continue; fi
    i=$((i + 1))
    [ $i -le 30 ] || die "another afs-run has held $lock for 30 s; if none is running, remove that directory"
    sleep 1
  done
  printf '%s\n' "$$" > "$lock/pid"
  cfg=$(
    printf 'data-urlencode = "grant_type=refresh_token"\n'
    printf 'data-urlencode = "refresh_token=%s"\n' "$(q "$(cred_get refresh_token)")"
    printf 'url = "%s"\n' "$(q "$endpoint")"
  )
  post
  if [ "$code" = 200 ] && [ -n "$(str refresh_token)" ] && [ -n "$(str access_token)" ]; then
    save_credential "$(str refresh_token)" || { rm -rf "$lock"; die "could not store this machine's next credential in $cred_file"; }
    rm -rf "$lock"
    person=$(str access_token)
    return 0
  fi
  rm -rf "$lock"
  case "$code" in
    4??) die "this machine's sign-in was refused ($(str error) $(str error_description)); run afs-run login again" ;;
    *) die "the token endpoint answered $code; try again" ;;
  esac
}

case "${1:-}" in
  login)
    shift
    folder=""
    name=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --folder) [ $# -ge 2 ] || die "--folder needs a folder path"; folder="$2"; shift 2 ;;
        --name) [ $# -ge 2 ] || die "--name needs a name for this machine"; name="$2"; shift 2 ;;
        *) die "login takes --folder <path> and --name <machine name>" ;;
      esac
    done
    [ -n "$cred_file" ] || die "set AGENTLEFS_MACHINE_CREDENTIAL (or HOME) so the credential has somewhere to live"
    resolve_endpoints
    [ -n "$name" ] || name=$(hostname 2>/dev/null || uname -n)
    cfg=$(
      printf 'data-urlencode = "client_name=%s"\n' "$(q "$name")"
      [ -n "$folder" ] && printf 'data-urlencode = "folder=%s"\n' "$(q "$folder")"
      printf 'url = "%s"\n' "$(q "${endpoint%/token}/device_authorization")"
    )
    post
    [ "$code" = 200 ] || die "the server refused a sign-in ($code $(str error) $(str error_description))"
    device=$(str device_code)
    user=$(str user_code)
    uri=$(str verification_uri)
    interval=$(num interval)
    left=$(num expires_in)
    [ -n "$device" ] && [ -n "$user" ] && [ -n "$uri" ] || die "the server's answer had no code"
    [ -n "$interval" ] || interval=5
    [ -n "$left" ] || left=600
    # What approving grants, in the words the approval page puts above Approve (DeviceSignInView).
    if [ -n "$folder" ]; then where="$folder"; else where="the folder you pick"; fi
    printf 'Approving lets AI agents started on this machine read and write in %s as agents you run, within your own access, until you remove the machine from your machines list (agentlefs.com/device).\n\n' "$where" >&2
    printf 'To sign this machine (%s) in to agentleFS:\n\n  1. Open %s in a browser where you are signed in.\n  2. Type the code  %s\n  3. Check what is asking, and approve.\n\nApprove only a code you started here. It expires in %s minutes. Waiting...\n(An AI agent running this for a person: give them this address and code as they are, and wait; never approve it yourself.)\n' \
      "$name" "$uri" "$user" "$((left / 60))" >&2
    deadline=$(($(now) + left))
    while [ "$(now)" -lt "$deadline" ]; do
      sleep "$interval"
      cfg=$(
        printf 'data-urlencode = "grant_type=urn:ietf:params:oauth:grant-type:device_code"\n'
        printf 'data-urlencode = "device_code=%s"\n' "$(q "$device")"
        printf 'url = "%s"\n' "$(q "$endpoint")"
      )
      post
      if [ "$code" = 200 ]; then
        [ -n "$(str refresh_token)" ] || die "the server's answer had no credential"
        save_credential "$(str refresh_token)" "$name" || die "could not store the credential in $cred_file"
        printf 'Signed in. The credential is in %s, readable by you alone.\nStart an agent with: afs-run --agent @<handle> -- <command>\n' "$cred_file" >&2
        exit 0
      fi
      case "$(str error)" in
        authorization_pending) ;;
        slow_down) interval=$((interval + 5)) ;;
        access_denied) die "the sign-in was denied in the browser" ;;
        expired_token) die "the code expired before it was approved; run afs-run login again" ;;
        "") [ "$code" = 000 ] || die "the token endpoint answered $code" ;;
        *) die "the sign-in failed: $(str error) $(str error_description)" ;;
      esac
    done
    die "the code expired before it was approved; run afs-run login again"
    ;;
  status)
    if [ -n "$cred_file" ] && [ -r "$cred_file" ] && [ -n "$(cred_get refresh_token)" ]; then
      printf 'Signed in to %s since %s; the credential is in %s.\nRevoke it in the console (Machines, on its /device page) or with: afs-run logout\n' \
        "$(cred_get endpoint | sed 's|/token$||')" "$(cred_get saved)" "$cred_file"
      exit 0
    fi
    printf 'This machine is not signed in. Run: afs-run login\n'
    exit 1
    ;;
  logout)
    if [ -z "$cred_file" ] || [ ! -r "$cred_file" ]; then
      printf 'This machine is not signed in.\n'
      exit 0
    fi
    resolve_endpoints
    cfg=$(
      printf 'data-urlencode = "token=%s"\n' "$(q "$(cred_get refresh_token)")"
      printf 'data-urlencode = "token_type_hint=refresh_token"\n'
      printf 'url = "%s"\n' "$(q "$revoke_url")"
    )
    post
    rm -f "$cred_file"
    [ "$code" = 200 ] || die "the credential is deleted here, but the server answered $code: revoke the machine in the console (Machines, on its /device page)"
    printf 'Signed out: this machine is revoked and its credential deleted.\n'
    exit 0
    ;;
esac

bridge=""
if [ "${1:-}" = mcp ]; then bridge=1; shift; fi
agent=""
seat="${AGENTLEFS_SEAT:-}"
github=""
scope=""
while [ $# -gt 0 ]; do
  case "$1" in
    --agent) [ $# -ge 2 ] || die "--agent needs an id or @handle"; agent="$2"; shift 2 ;;
    --seat) die "afs-run takes no seat: the worker takes its own (take_seat). For --github, the shift that holds the seat passes it as AGENTLEFS_SEAT" ;;
    --github) [ $# -ge 2 ] || die "--github needs owner/repo"; github="$2"; shift 2 ;;
    --scope) [ $# -ge 2 ] || die "--scope needs permissions, e.g. issues:write"; scope="$2"; shift 2 ;;
    --) shift; break ;;
    -h|--help) sed -n '2,/^set -u$/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument $1 (the command goes after --)" ;;
  esac
done
[ -n "$agent" ] || die "--agent is required"
if [ -n "$bridge" ]; then
  [ $# -eq 0 ] || die "afs-run mcp takes no command: it is the MCP server"
  [ -z "$github" ] || die "afs-run mcp takes no --github"
  # The client's messages arrive on this standard input; the bridge reads them as fd 3, since a
  # command started in the background has its standard input taken away.
  exec 3<&0
else
  [ $# -gt 0 ] || die "no command given after --"
fi
case "$github" in ""|*/*) ;; *) die "--github is owner/repo" ;; esac
# The seat is read only for GitHub's exchange, and goes into curl's configuration: one line of
# <epoch>.<uuid>, or a newline could add a line carrying the bearer elsewhere.
[ -n "$github" ] || seat=""
case "$seat" in
  "") ;;
  *[!0-9a-fA-F.-]*|.*|*.) die "AGENTLEFS_SEAT is not a seat token (<epoch>.<uuid>)" ;;
esac

# The credential this starts from: the file wins, as it does for the CLI and the stdio MCP server;
# then the variable; then this machine's own. `started_from` names it in every refusal.
#
# On a signed-in machine a token variable is REFUSED, naming it, unless an afs-run above this one put
# it there (AGENTLEFS_TOKEN_FROM=afs-run: a bridge under `afs-run --agent` starts from its launcher's
# current token, for that same agent). Neither silent choice is safe: a variable left in a shell by
# some other setup started agents as a credential the person never chose for this machine (the
# 2026-11-21 production test ran `env -u AGENTLEFS_TOKEN` to get past it), and preferring the machine
# would silently ignore a variable someone set on purpose. Refusing costs one `unset`, says which, and
# leaves a deliberate variable usable by pointing AGENTLEFS_MACHINE_CREDENTIAL elsewhere.
person=""
started_from=""
ambient=""
if [ -n "${AGENTLEFS_TOKEN_FILE:-}" ]; then
  [ -r "$AGENTLEFS_TOKEN_FILE" ] || die "AGENTLEFS_TOKEN_FILE names a file that cannot be read"
  person=$(tr -d ' \t\r\n' < "$AGENTLEFS_TOKEN_FILE")
  started_from="AGENTLEFS_TOKEN_FILE ($AGENTLEFS_TOKEN_FILE)"; ambient=AGENTLEFS_TOKEN_FILE
elif [ -n "${AGENTLEFS_TOKEN:-}" ]; then
  person="$AGENTLEFS_TOKEN"
  started_from="AGENTLEFS_TOKEN"; ambient=AGENTLEFS_TOKEN
fi
if [ -n "$ambient" ] && [ "${AGENTLEFS_TOKEN_FROM:-}" != afs-run ] && [ -n "$(cred_get refresh_token)" ]; then
  die "$ambient is set, and this machine is signed in too ($cred_file); afs-run will not guess which to start @${agent#@} from. Unset $ambient to start from this machine's sign-in, or set AGENTLEFS_MACHINE_CREDENTIAL=none to start from $ambient"
fi
resolve_endpoints
# A GitHub Actions job with a trust: its ID token is the credential, one per exchange (id_token).
trust=""
if [ -z "$person" ] && [ -n "${AGENTLEFS_TRUST:-}" ]; then
  [ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ] && [ -n "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ] ||
    die "AGENTLEFS_TRUST is for a GitHub Actions job: give the job 'permissions: id-token: write' so GitHub can sign it an ID token"
  trust="$AGENTLEFS_TRUST"
  started_from="this GitHub Actions job's ID token (trust $trust)"
fi
if [ -z "$person" ] && [ -z "$trust" ] && [ -n "$cred_file" ] && [ -r "$cred_file" ]; then
  machine_sign_in
  started_from="this machine's sign-in ($cred_file)"
fi
[ -n "$person" ] || [ -n "$trust" ] || die "no agentleFS credential: run afs-run login once on this machine, set AGENTLEFS_TRUST in a GitHub Actions job, or set AGENTLEFS_TOKEN or AGENTLEFS_TOKEN_FILE for this command"
# The starting credential is used for the first exchanges only.
unset AGENTLEFS_TOKEN AGENTLEFS_TOKEN_FILE AGENTLEFS_TOKEN_FROM

github_api="${AGENTLEFS_GITHUB_API:-https://api.github.com}"

dir=$(mktemp -d "${TMPDIR:-/tmp}/afs-run.XXXXXX") || die "could not make a private directory"
chmod 700 "$dir"

put() { printf '%s' "$2" > "$dir/$1.tmp" && mv -f "$dir/$1.tmp" "$dir/$1"; }

# grant <resource> <scope> | renew <refresh token>: sets tok, ref, ttl; status 0 issued, 1 refused for
# good, 2 not answered (retry).
token_call() {
  case "$code" in
    200) tok=$(str access_token); ref=$(str refresh_token); ttl=$(num expires_in)
         [ -n "$tok" ] && [ -n "$ref" ] && [ -n "$ttl" ] && return 0
         why="an answer with no token"; return 2 ;;
    4??) why="$(str error) $(str error_description)"; return 1 ;;
    *) why="the token endpoint answered $code"; return 2 ;;
  esac
}
# The job's ID token from GitHub, its audience this server's token endpoint: sets `person`; 0 got,
# 2 not answered. The request token goes in a header on curl's standard input, never argv.
id_token() {
  cfg=$(
    printf 'header = "Authorization: bearer %s"\n' "$(q "$ACTIONS_ID_TOKEN_REQUEST_TOKEN")"
    printf 'get\ndata-urlencode = "audience=%s"\n' "$(q "$endpoint")"
    printf 'url = "%s"\n' "$(q "$ACTIONS_ID_TOKEN_REQUEST_URL")"
  )
  post
  person=$(str value)
  [ "$code" = 200 ] && [ -n "$person" ] && return 0
  why="GitHub answered $code for the job's ID token"; return 2
}
grant() {
  if [ -n "$trust" ]; then id_token || return 2; fi
  cfg=$(
    printf 'data-urlencode = "grant_type=urn:ietf:params:oauth:grant-type:token-exchange"\n'
    if [ -n "$trust" ]; then
      printf 'data-urlencode = "subject_token_type=urn:ietf:params:oauth:token-type:jwt"\n'
      printf 'data-urlencode = "client_id=%s"\n' "$(q "$trust")"
    else
      printf 'data-urlencode = "subject_token_type=urn:ietf:params:oauth:token-type:access_token"\n'
    fi
    printf 'data-urlencode = "subject_token=%s"\n' "$(q "$person")"
    printf 'data-urlencode = "resource=%s"\n' "$(q "$1")"
    printf 'data-urlencode = "agent=%s"\n' "$(q "$agent")"
    # Only an outside target asks for the seat; agentleFS fences its own writes by it.
    [ "$1" != agentlefs ] && [ -n "$seat" ] && printf 'data-urlencode = "seat=%s"\n' "$(q "$seat")"
    [ -n "${2:-}" ] && printf 'data-urlencode = "scope=%s"\n' "$(q "$2")"
    printf 'url = "%s"\n' "$(q "$endpoint")"
  )
  post
  token_call
}
renew() {
  cfg=$(
    printf 'data-urlencode = "grant_type=refresh_token"\n'
    printf 'data-urlencode = "refresh_token=%s"\n' "$(q "$1")"
    printf 'url = "%s"\n' "$(q "$endpoint")"
  )
  post
  token_call
}

# When to renew a credential living `ttl` seconds: at about two thirds, less up to a tenth, jittered.
next_at() {
  j=$(awk -v s="$$$(now)" -v n="$(($1 / 10))" 'BEGIN { srand(s); print int(rand() * (n + 1)) }')
  t=$(($1 * 2 / 3 - j)); [ "$t" -ge 1 ] || t=1
  echo $(($(now) + t))
}

revoke_github() {
  [ -n "$1" ] || return 0
  printf 'header = "Authorization: Bearer %s"\nurl = "%s/installation/token"\n' "$1" "$(q "$github_api")" |
    curl -sS --max-time 10 -o /dev/null -X DELETE -H "Accept: application/vnd.github+json" -K - 2>/dev/null || true
}
revoke_renewal() {
  [ -n "$1" ] || return 0
  printf 'data-urlencode = "token=%s"\ndata-urlencode = "token_type_hint=refresh_token"\nurl = "%s"\n' "$(q "$1")" "$(q "$revoke_url")" |
    curl -sS --max-time 10 -o /dev/null -K - 2>/dev/null || true
}

a_tok=""; a_ref=""; g_tok=""; g_ref=""; child=""
cleanup() {
  revoke_github "$g_tok"; g_tok=""
  revoke_renewal "$g_ref"; g_ref=""
  revoke_renewal "$a_ref"; a_ref=""
  rm -rf "$dir"
}
stop_child() {
  [ -n "$child" ] || return 0
  kill -TERM "$child" 2>/dev/null
  i=0
  while kill -0 "$child" 2>/dev/null && [ $i -lt 10 ]; do sleep 1; i=$((i + 1)); done
  kill -KILL "$child" 2>/dev/null
  wait "$child" 2>/dev/null
  child=""
}
trap 'cleanup' EXIT
trap 'stop_child; exit 130' INT
trap 'stop_child; exit 143' TERM

# afs-run mcp: each JSON-RPC message on standard input, one per line, to the MCP endpoint with the
# token the renewal loop last wrote; each answer to standard output as one line. A server-sent-event answer is unwrapped to its data lines. A notification's
# empty answer prints nothing; a refusal with no JSON-RPC body is answered as an error for its id.
mcp_bridge() {
  sid=""
  client=""
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    # The client's own name, from its initialize, for the seat holder below.
    if [ -z "$client" ] && printf '%s' "$line" | grep -q '"method"[[:space:]]*:[[:space:]]*"initialize"'; then
      client=$(printf '%s' "$line" | sed -n 's/.*"clientInfo"[[:space:]]*:[[:space:]]*{[^}]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | tr -cd 'A-Za-z0-9 ._-' | cut -c 1-40)
    fi
    # A take_seat or take_over names its holder as "<client> via afs-run on <machine>" (the call's clientInfo, which
    # the server records), unless the client named itself on the call.
    if printf '%s' "$line" | grep -q '"action"[[:space:]]*:[[:space:]]*"take_\(seat\|over\)"' &&
      ! printf '%s' "$line" | grep -q 'io.modelcontextprotocol/clientInfo'; then
      holder="$(machine_label)"; [ -z "$client" ] || holder="$client via $holder"
      info="\"io.modelcontextprotocol/clientInfo\":{\"name\":\"$holder\"}"
      if printf '%s' "$line" | grep -q '"_meta"[[:space:]]*:[[:space:]]*{'; then
        line=$(printf '%s' "$line" | sed "s|\"_meta\"[[:space:]]*:[[:space:]]*{|\"_meta\":{$info,|")
      else
        line=$(printf '%s' "$line" | sed "s|\"params\"[[:space:]]*:[[:space:]]*{|\"params\":{\"_meta\":{$info},|")
      fi
    fi
    printf '%s' "$line" > "$dir/bridge-request.json"
    cfg=$(
      printf 'header = "Authorization: Bearer %s"\n' "$(q "$(cat "$AGENTLEFS_TOKEN_FILE")")"
      printf 'header = "Content-Type: application/json"\nheader = "Accept: application/json, text/event-stream"\n'
      printf 'user-agent = "afs-run"\n'
      [ -n "$sid" ] && printf 'header = "Mcp-Session-Id: %s"\n' "$(q "$sid")"
      printf 'data-binary = "@%s"\nurl = "%s"\n' "$(q "$dir/bridge-request.json")" "$(q "$mcp_url")"
    )
    rm -f "$dir/bridge-headers" "$dir/bridge-body"
    code=$(printf '%s\n' "$cfg" | curl -sS --max-time 600 -D "$dir/bridge-headers" -o "$dir/bridge-body" -w '%{http_code}' -K - 2>/dev/null) || code=000
    got=$(sed -n 's/^[Mm][Cc][Pp]-[Ss][Ee][Ss][Ss][Ii][Oo][Nn]-[Ii][Dd]: *\([^[:space:]]*\).*/\1/p' "$dir/bridge-headers" 2>/dev/null | tail -n 1)
    [ -z "$got" ] || sid=$got
    if grep -qi '^content-type: *text/event-stream' "$dir/bridge-headers" 2>/dev/null; then
      sed -n 's/^data: \{0,1\}//p' "$dir/bridge-body" | tr -d '\r'
    elif [ -s "$dir/bridge-body" ] && grep -q '"jsonrpc"' "$dir/bridge-body"; then
      tr -d '\r\n' < "$dir/bridge-body"; printf '\n'
    else
      id=$(printf '%s' "$line" | sed -n 's/^.*"id"[[:space:]]*:[[:space:]]*\("[^"]*"\).*$/\1/p' | head -n 1)
      [ -n "$id" ] || id=$(printf '%s' "$line" | sed -n 's/^.*"id"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*$/\1/p' | head -n 1)
      if [ -n "$id" ] && ! printf '%s' "$line" | grep -qE '"(result|error)"[[:space:]]*:'; then
        printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32000,"message":"agentleFS answered HTTP %s"}}\n' "$id" "$code"
      fi
    fi
  done
}

refused() {
  printf 'afs-run: %s; stopping the command\n' "$*" >&2
  stop_child
  exit 77
}

# The first exchange was refused: say so, which credential it started from, and what would help.
start_refused() {
  printf 'afs-run: %s (started from %s)\n' "$*" "$started_from" >&2
  case "$why" in
    *"agent: not found"*)
      if [ -z "$ambient" ]; then
        printf 'afs-run: an agent this machine starts must work in the folder this machine was approved for: add it on that folder in the console as Editor or Manager, or spawn it there with folder=\n' >&2
      else
        printf 'afs-run: the credential must belong to the agent, an identity above it, or one that can write the folder it works in\n' >&2
      fi ;;
  esac
  exit 1
}

# ── start ──
grant agentlefs || start_refused "agentlefs refused: $why"
a_tok=$tok; a_ref=$ref; a_exp=$(($(now) + ttl)); a_next=$(next_at "$ttl"); put agentlefs-token "$a_tok"
g_next=""
if [ -n "$github" ]; then
  if ! grant "github:$github" "$scope"; then
    printf 'afs-run: github:%s refused: %s\n' "$github" "$why" >&2
    case "$why" in
      *seat_required*) printf 'afs-run: this agent is driven from a seat, and GitHub'"'"'s credential needs it: start afs-run from the shift that holds the seat, with the seat in AGENTLEFS_SEAT\n' >&2 ;;
    esac
    exit 1
  fi
  g_tok=$tok; g_ref=$ref; g_exp=$(($(now) + ttl)); g_next=$(next_at "$ttl"); put github-token "$g_tok"
fi
person=""

(
  # The job's ID-token request and its trust are the launcher's starting credential, never the
  # command's: with them it could mint ID tokens and exchange them past what was granted here.
  unset ACTIONS_ID_TOKEN_REQUEST_URL ACTIONS_ID_TOKEN_REQUEST_TOKEN AGENTLEFS_TRUST
  AGENTLEFS_TOKEN="$a_tok"; AGENTLEFS_TOKEN_FILE="$dir/agentlefs-token"; AGENTLEFS_URL="$mcp_url"
  # Marked as this launcher's, so an afs-run the command starts (afs-run mcp) starts from them.
  AGENTLEFS_TOKEN_FROM=afs-run
  export AGENTLEFS_TOKEN AGENTLEFS_TOKEN_FILE AGENTLEFS_URL AGENTLEFS_TOKEN_FROM
  if [ -n "$g_tok" ]; then
    GH_TOKEN="$g_tok"; GITHUB_TOKEN="$g_tok"; GH_TOKEN_FILE="$dir/github-token"
    export GH_TOKEN GITHUB_TOKEN GH_TOKEN_FILE
    # git asks the helper on every use, so it always gets the current token; the empty helper first
    # clears any helper configured for github.com.
    n=${GIT_CONFIG_COUNT:-0}
    eval "GIT_CONFIG_KEY_$n=credential.https://github.com.helper GIT_CONFIG_VALUE_$n=''"
    eval "export GIT_CONFIG_KEY_$n GIT_CONFIG_VALUE_$n"
    m=$((n + 1))
    helper="!f() { test \"\$1\" = get || exit 0; printf 'username=x-access-token\\npassword=%s\\n' \"\$(cat '$dir/github-token')\"; }; f"
    eval "GIT_CONFIG_KEY_$m=credential.https://github.com.helper GIT_CONFIG_VALUE_$m=\$helper"
    eval "export GIT_CONFIG_KEY_$m GIT_CONFIG_VALUE_$m"
    GIT_CONFIG_COUNT=$((n + 2)); export GIT_CONFIG_COUNT
  fi
  if [ -n "$bridge" ]; then exec 0<&3 3<&-; mcp_bridge; exit $?; fi
  exec "$@"
) &
child=$!

# ── supervise ──
# A renewal that is not answered is retried until the credential would expire; one refused stops it.
while kill -0 "$child" 2>/dev/null; do
  t=$(now)
  if [ "$t" -ge "$a_next" ]; then
    if renew "$a_ref"; then
      a_tok=$tok; a_ref=$ref; a_exp=$((t + ttl)); a_next=$(next_at "$ttl"); put agentlefs-token "$a_tok"
    elif [ $? -eq 1 ]; then a_ref=""; refused "the agent's renewal was refused ($why)"
    elif [ "$t" -ge "$a_exp" ]; then refused "the agent's token expired before it could be renewed ($why)"
    else a_next=$((t + 5)); fi
  fi
  if [ -n "$g_next" ] && [ "$t" -ge "$g_next" ]; then
    old=$g_tok
    if renew "$g_ref"; then
      g_tok=$tok; g_ref=$ref; g_exp=$((t + ttl)); g_next=$(next_at "$ttl"); put github-token "$g_tok"
      revoke_github "$old"
    elif [ $? -eq 1 ]; then g_ref=""; refused "the github:$github renewal was refused ($why)"
    elif [ "$t" -ge "$g_exp" ]; then refused "the GitHub token expired before it could be renewed ($why)"
    else g_next=$((t + 5)); fi
  fi
  # A short nap, so a child that ended or a signal is noticed within a second.
  sleep 1 &
  wait $! 2>/dev/null
done
wait "$child"
status=$?
child=""
exit "$status"
